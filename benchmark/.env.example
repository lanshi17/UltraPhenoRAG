# .env.example - 填入真实凭据前请勿提交到 VCS
# 用法示例：
#   cp .env.example benchmark/.env
#   编辑 benchmark/.env 并填入真实密钥/端点

########################################
# GraphRAG / benchmark 运行所需配置
# 消费点：benchmark/config/environment.py（load_environment）
# settings.yaml 通过 ${RAG_API_KEY} 等引用
########################################
# Microsoft GraphRAG 与 LightRAG 共用
RAG_API_KEY=
RAG_API_BASE=

# 模型配置（可替换为你使用的供应商/模型标识）
RAG_MODEL_PROVIDER=openai
RAG_COMPLETION_MODEL=gpt-5-mini
RAG_EMBEDDING_MODEL=text-embedding-3-large
RAG_EMBEDDING_DIMENSION=3072
RAG_EMBEDDING_MAX_TOKEN_SIZE=8192

# 可选：如果评估脚本直接使用 OpenAI-style env（也是 JUDGE_* 的回退）
OPENAI_API_KEY=
OPENAI_API_BASE=

########################################
# Judge（LLM-as-Judge）
# 消费点：benchmark/qa/judge.py（未显式传 CLI --judge-* 参数时生效）
# 优先级：显式 CLI 参数 > JUDGE_* > OPENAI_*
########################################
JUDGE_API_KEY=
JUDGE_API_BASE=
JUDGE_COMPLETION_MODEL=gpt-5
JUDGE_EMBEDDING_MODEL=text-embedding-3-large

# （回退变量 OPENAI_API_KEY/OPENAI_API_BASE 见上方 GraphRAG 段）

########################################
# 运行/调试开关（可选，当前代码未读取，仅作占位）
########################################
# 是否在使用中记录成本信息（如果供应商返回 cost 数据）
ENABLE_COST_REPORTING=false
# 环境标签，用于日志/telemetry
ENV=development

########################################
# 网络代理设置（如需走代理才填）
# 注意：在使用 SOCKS5 代理时，需在虚拟环境安装 httpx[socks] 或取消代理
########################################
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1

########################################
# 安全提示
########################################
# - 请勿在公共仓库提交真实密钥
# - 推荐把 .env 加入 .gitignore
# - 如果使用代理，优先在容器/虚拟环境外设置以避免依赖缺失
