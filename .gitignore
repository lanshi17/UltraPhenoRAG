# Python and build artifacts
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.venv/
benchmark/baseline/libs/
*.log

# Local credentials (keep example configuration)
**/.env
**/.env.*
!**/.env.example
*.pem
*.key

# Runtime data: only lightweight configuration and prompts are versioned
/benchmark/data/*
!/benchmark/data/microsoft_graphrag/
/benchmark/data/microsoft_graphrag/*
!/benchmark/data/microsoft_graphrag/settings.yaml
!/benchmark/data/microsoft_graphrag/prompts/

# Generated evaluation output; keep report source code and Markdown summaries
/benchmark/results/
